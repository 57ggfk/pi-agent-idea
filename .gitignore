# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/*.iml
.idea/modules.xml
.idea/workspace.xml
.idea/misc.xml
.intellijPlatform/

# Node
node_modules/
web/dist/
web/e2e/report/
playwright-report/
test-results/
# Screenshots written by web/probe-*.mjs (dev-server geometry probes).
web/probe-*.png
# JSON verdicts written by web/probe-*.mjs (per-run evidence, not source).
web/probe-*.json

# Logs
*.log
# 外部 agent / CLI 工具的本地产物（状态目录、缓存、配置文件）。
# 不带前导 `/`，任意层级生效；有无前导点、首字母大小写都覆盖。
.zcode*
[Zz][Cc]ode*
.idea/

# Agent scratch / credentials.
# The per-agent command copies (.codebuddy/) and the workspace agent state
# (.workbuddy/, incl. the mirrored speckit commands and the daily work log)
# are machine-local: regenerate with `specify init --here --force
# --ignore-agent-tools --integration codebuddy --script py`, never merge
# them through git.
.codebuddy/
.workbuddy/
.workbuddy-ai/

# Speckit: the rule body (.specify/memory/) and the templates
# (.specify/templates/) are repository assets — they are what "the rules"
# means here, so they are tracked. The toolchain copy and per-checkout state
# are not: scripts/ is regenerated by `specify init --force`, and
# feature.json is rewritten on every feature switch.
.specify/scripts/
.specify/extensions/
.specify/integrations/
.specify/workflows/
.specify/feature.json
.specify/integration.json
.specify/.gitignore

# 本机私有的 agent 约定（提交者身份、提交时间折算、本机环境等），只对作者生效，不入库。
agents.local.md

# 版本执行提示词：派发给外部 agent 的临时编排稿，只留本地，不入库。
# 命名约定 <version>-PROMPT.md，任意版本前缀均忽略，避免每版本改一次规则。
specs/*-PROMPT.md

# web/node_modules is a junction/symlink to a shared store (git cannot track it)
web/node_modules

# test/e2e-project 是 runIde e2e 挂载的沙箱项目（README：Not a real codebase）。
# 真机 session 里 pi 会在里面写文件（实测产出 bugfix-flowchart.svg /
# dashboard-blocks.svg / shengxiao.html / sunset-cat.svg），这类一次性产物无任何
# 用例、脚本或探针引用，不入库，避免每次真机验收都重新污染工作区。
# 确需入库的夹具用 `git add -f`（browser 分支已有 bubbles.html 等先例）。
test/e2e-project/*.svg
test/e2e-project/*.html
