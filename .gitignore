# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/*.iml
.idea/modules.xml
.idea/workspace.xml
.idea/misc.xml
.intellijPlatform/

# Node
node_modules/
web/dist/
web/e2e/report/
playwright-report/
test-results/
# Screenshots written by web/probe-*.mjs (dev-server geometry probes).
web/probe-*.png
# JSON verdicts written by web/probe-*.mjs (per-run evidence, not source).
web/probe-*.json

# Logs
*.log
# 外部 agent / CLI 工具的本地产物（状态目录、缓存、配置文件）。
# 不带前导 `/`，任意层级生效；有无前导点、首字母大小写都覆盖。
.zcode*
[Zz][Cc]ode*
.idea/

# Agent scratch / credentials.
# Spec Kit's local install (.specify/), its per-agent command copies
# (.codebuddy/) and the workspace agent state (.workbuddy/, incl. the
# mirrored speckit commands and the daily work log) are machine-local:
# regenerate with `specify init --here --force --ignore-agent-tools
# --integration codebuddy --script py`, never merge them through git.
.codebuddy/
.specify/
.workbuddy/
.workbuddy-ai/

# 版本执行提示词：派发给外部 agent 的临时编排稿，只留本地，不入库。
# 命名约定 <version>-PROMPT.md，任意版本前缀均忽略，避免每版本改一次规则。
specs/*-PROMPT.md
