# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/*.iml
.idea/modules.xml
.idea/workspace.xml
.idea/misc.xml
.intellijPlatform/

# Node
node_modules/
web/dist/
web/e2e/report/
playwright-report/
test-results/
# Screenshots written by web/probe-*.mjs (dev-server geometry probes).
web/probe-*.png

# Logs
*.log
# zcode（CLI/agent）本地产物：目录、缓存、状态文件，名字以此开头即忽略。
# 不带前导 `/`，任意层级生效；大小写差异由 core.ignorecase 兜住（Windows/macOS 默认 true）。
.zcode*
# 同一工具的变体写法（无前导点、首字母大写）：ZCode/、zcode/、zCode/
[Zz][Cc]ode*
.idea/

# Agent scratch / credentials.
# Spec Kit's local install (.specify/), its per-agent command copies
# (.codebuddy/) and the workspace agent state (.workbuddy/, incl. the
# mirrored speckit commands and the daily work log) are machine-local:
# regenerate with `specify init --here --force --ignore-agent-tools
# --integration codebuddy --script py`, never merge them through git.
.codebuddy/
.specify/
.workbuddy/

# 版本执行提示词：无人值守派发给外部 agent 的临时编排稿，只留本地。
# 命名约定 <version>-ZCODE-PROMPT.md，任意前缀均忽略，避免每版本改一次规则。
specs/*-ZCODE-PROMPT.md
