<idea-plugin>
    <id>dev.pi.agent</id>
    <name>Pi Agent</name>
    <vendor>57ggfk</vendor>
    <description><![CDATA[
    Pi coding agent, embedded in your IDE.<br/>
    Chat with the pi coding agent from a tool window: streaming markdown answers,
    thinking blocks, tool-call cards, model & session management, and GUI management
    for pi's MCP servers, packages and skills. Editor actions hand selections to pi,
    file references jump back into the editor, and a status bar widget keeps the
    agent state visible.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF is a separate platform module in IntelliJ IDEA 2026.2+, but older
         IDEs (2023.3–2026.1) provide JCEF from the platform without exposing
         this module. Optional depends links the module's classes when present
         and keeps the plugin loadable everywhere else. -->
    <depends optional="true" config-file="jcef-features.xml">com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Pi Agent"
                    anchor="right"
                    factoryClass="dev.pi.agent.toolwindow.PiAgentToolWindowFactory"
                    icon="/icons/piAgent.svg"
                    canCloseContents="false"/>
        <postStartupActivity implementation="dev.pi.agent.toolwindow.PiAgentStartupActivity"/>

        <!-- Balloon notifications (e.g. background run finished). -->
        <notificationGroup id="Pi Agent" displayType="BALLOON"/>

        <!-- Status bar state indicator. -->
        <statusBarWidgetFactory id="PiAgentStatusBarWidget"
                                implementation="dev.pi.agent.toolwindow.PiStatusBarWidgetFactory"/>

        <!-- Settings → Tools → Pi Agent: custom pi path, auto-open. -->
        <applicationConfigurable parentId="tools"
                                 id="dev.pi.agent.settings"
                                 displayName="Pi Agent"
                                 instance="dev.pi.agent.settings.PiAgentSettingsConfigurable"/>

        <!-- Editor integration (selection-based). -->
        <group id="PiAgent.EditorPopup" popup="true" text="Pi Agent" description="Send code to the pi agent">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="PiAgent.ExplainSelection"
                    class="dev.pi.agent.editor.ExplainWithPi"
                    text="Explain with Pi"
                    description="Ask pi to explain the selected code"/>
            <action id="PiAgent.FixSelection"
                    class="dev.pi.agent.editor.FixWithPi"
                    text="Fix with Pi"
                    description="Ask pi to fix the selected code"/>
            <action id="PiAgent.SendSelection"
                    class="dev.pi.agent.editor.SendSelectionToPi"
                    text="Send Selection to Pi"
                    description="Send the selected code to pi with file context"/>
        </group>

        <!-- File integration (project view / editor tab context menus).
             All group ids are platform-wide, so this works on every
             JetBrains IDE, not just IDEA. -->
        <group id="PiAgent.FilePopup" popup="true" text="Pi Agent" description="Send a file to the pi agent">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <action id="PiAgent.SendFile"
                    class="dev.pi.agent.editor.SendFileToPi"
                    text="Send File to Pi Agent"
                    description="Send the whole file to pi with its path context"/>
            <action id="PiAgent.ExplainFile"
                    class="dev.pi.agent.editor.ExplainFileWithPi"
                    text="Explain File with Pi"
                    description="Ask pi to summarize the whole file and flag anything suspicious"/>
        </group>

        <!-- Commit panel: generate the commit message with a headless one-shot
             pi. Vcs.MessageActionGroup renders in the commit tool window
             toolbar next to the message-history button;
             Vcs.Commit.PrimaryCommitActions is the dropdown beside the Commit
             button. Both exist across 233–263. -->
        <action id="PiAgent.GenerateCommitMessage"
                class="dev.pi.agent.vcs.PiGenerateCommitMessageAction"
                icon="AllIcons.Actions.IntentionBulb"
                text="Generate Commit Message with Pi"
                description="Ask pi to write a Conventional Commits message for the included changes">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift C"/>
        </action>
    </extensions>
</idea-plugin>
