<idea-plugin>
    <id>dev.pi.agent</id>
    <name>Pi Agent</name>
    <vendor>57ggfk</vendor>
    <description><![CDATA[
    Pi coding agent, embedded in your IDE.<br/>
    Chat with the pi coding agent from a tool window: streaming markdown answers,
    thinking blocks, tool-call cards, model & session management, and GUI management
    for pi's MCP servers, packages and skills. Editor actions hand selections to pi,
    file references jump back into the editor, and a status bar widget keeps the
    agent state visible.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF is a separate platform module in IntelliJ IDEA 2026.2+, but older
         IDEs (2023.3–2026.1) provide JCEF from the platform without exposing
         this module. Optional depends links the module's classes when present
         and keeps the plugin loadable everywhere else. -->
    <depends optional="true" config-file="jcef-features.xml">com.intellij.modules.jcef</depends>

    <!-- IDE-side strings (spec 008 US3): actions and notifications follow the
         IDE language pack. Brand names stay literal — only descriptions and
         the translatable action titles go through %key. -->
    <resource-bundle>messages.PiAgentBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Pi Agent"
                    anchor="right"
                    factoryClass="dev.pi.agent.toolwindow.PiAgentToolWindowFactory"
                    icon="/icons/piAgent.svg"
                    canCloseContents="false"/>
        <postStartupActivity implementation="dev.pi.agent.toolwindow.PiAgentStartupActivity"/>

        <!-- Balloon notifications (e.g. background run finished). -->
        <notificationGroup id="Pi Agent" displayType="BALLOON"/>

        <!-- Status bar state indicator. -->
        <statusBarWidgetFactory id="PiAgentStatusBarWidget"
                                implementation="dev.pi.agent.toolwindow.PiStatusBarWidgetFactory"/>

        <!-- Settings → Tools → Pi Agent: custom pi path, auto-open. -->
        <applicationConfigurable parentId="tools"
                                 id="dev.pi.agent.settings"
                                 displayName="Pi Agent"
                                 instance="dev.pi.agent.settings.PiAgentSettingsConfigurable"/>
    </extensions>

    <!-- Actions MUST live in a top-level <actions> section: <group>/<action>
         inside <extensions> is silently ignored by the descriptor parser
         (the editor context menus never registered in v0.1.0–v0.4.0). -->
    <actions>
        <!-- i18n (spec 008 FR-010): actions and groups are localized by ID, not
             by %key. The platform resolves `action.<action-id>.text` /
             `action.<action-id>.description` (and `group.<group-id>.*`) from
             <resource-bundle> ONLY when the element has no text/description
             attribute. A literal text="%some.key" is never expanded — the menu
             then shows "%some.key" (this shipped in 0.5.4). Do not add text=
             back here; add the key to messages/PiAgentBundle*.properties
             instead. Verified against every bundled JetBrains plugin: none of
             them puts %key into <action text>. -->
        <!-- Editor integration (selection-based). The group icon is the same
             16x16 stroke glyph as the tool window (one source of truth); the
             platform scales it to the menu row height. The group label is the
             brand name and stays literal (spec 008 FR-012). -->
        <group id="PiAgent.EditorPopup" popup="true" text="Pi Agent" icon="/icons/piAgent.svg">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <action id="PiAgent.ExplainSelection" class="dev.pi.agent.editor.ExplainWithPi"/>
            <action id="PiAgent.FixSelection" class="dev.pi.agent.editor.FixWithPi"/>
            <action id="PiAgent.SendSelection" class="dev.pi.agent.editor.SendSelectionToPi"/>
        </group>

        <!-- File integration (project view / editor tab context menus).
             All group ids are platform-wide, so this works on every
             JetBrains IDE, not just IDEA. Add Directory sits before Send
             File: on a directory it is the one enabled item (FR-003). -->
        <group id="PiAgent.FilePopup" popup="true" text="Pi Agent" icon="/icons/piAgent.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <action id="PiAgent.AddDirectory" class="dev.pi.agent.editor.AddDirectoryToPi"/>
            <action id="PiAgent.SendFile" class="dev.pi.agent.editor.SendFileToPi"/>
            <action id="PiAgent.ExplainFile" class="dev.pi.agent.editor.ExplainFileWithPi"/>
        </group>

        <!-- Commit panel: generate the commit message with a headless one-shot
             pi. Vcs.MessageActionGroup renders in the commit tool window
             toolbar next to the message-history button;
             Vcs.Commit.PrimaryCommitActions is the dropdown beside the Commit
             button. Both exist across 233–263. -->
        <action id="PiAgent.GenerateCommitMessage"
                class="dev.pi.agent.vcs.PiGenerateCommitMessageAction"
                icon="AllIcons.Actions.IntentionBulb">
            <add-to-group group-id="Vcs.MessageActionGroup" anchor="first"/>
            <add-to-group group-id="Vcs.Commit.PrimaryCommitActions" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift C"/>
        </action>
    </actions>
</idea-plugin>
