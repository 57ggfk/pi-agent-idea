<idea-plugin>
    <id>dev.pi.agent</id>
    <name>Pi Agent</name>
    <vendor>57ggfk</vendor>
    <description><![CDATA[
    Pi coding agent, embedded in your IDE.<br/>
    Chat with the pi coding agent from a tool window: streaming markdown answers,
    thinking blocks, tool-call cards, model & session management, and GUI management
    for pi's MCP servers, packages and skills.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- JCEF ships as the bundled "Web Browser (JCEF)" plugin; depending on it
         links our classloader to the JCEF classes (com.intellij.ui.jcef, org.cef). -->
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Pi Agent"
                    anchor="right"
                    factoryClass="dev.pi.agent.toolwindow.PiAgentToolWindowFactory"
                    canCloseContents="false"/>
        <postStartupActivity implementation="dev.pi.agent.toolwindow.PiAgentStartupActivity"/>
    </extensions>
</idea-plugin>
