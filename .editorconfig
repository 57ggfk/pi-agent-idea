root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{kt,kts,java,json,xml,gradle}]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,mjs,css,html,yml,yaml,svg,sh,py,ps1}]
indent_style = space
indent_size = 2

[*.bat]
end_of_line = crlf
